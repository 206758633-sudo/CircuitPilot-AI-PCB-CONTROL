# CircuitPilot environment variables (optional; the desktop app normally needs none).
# Copy to .env only for local development. Never commit real keys.

# --- Local runtime ---
# Override the state directory (defaults to the app data dir / repo artifacts/state).
# CIRCUITPILOT_STATE_DIR=/absolute/path/to/state
# Override the evidence directory (defaults to <state>/evidence).
# CIRCUITPILOT_EVIDENCE_DIR=/absolute/path/to/evidence
# Runtime HTTP port used by the desktop shell (default: 4178).
# CIRCUITPILOT_RUNTIME_PORT=4178
# Vite dev server / console URL used by the frontend.
# VITE_RUNTIME_URL=http://127.0.0.1:4178

# --- EDA bridge ---
# 嘉立创EDA (LCEDA Pro) remote-debugging port; keep the vendor editor open.
# CIRCUITPILOT_EDA_CDP_PORT=9222
# EasyEDA bridge port (only for the EasyEDA workflow).
# CIRCUITPILOT_BRIDGE_PORT=49620

# --- Safety / testing switches ---
# Keep dry-run on unless you are on a disposable test board.
# CIRCUITPILOT_GATE_DRY_RUN=1
# Allow GUI evaluation fallbacks (development only; never enable for untrusted input).
# CIRCUITPILOT_ALLOW_GUI_EVAL=0
