{
  "name": "circuitpilot-control-demo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "acceptance": "node scripts/acceptance.mjs",
    "archive:live-evidence": "node scripts/archive-live-evidence.mjs",
    "automation:run": "node scripts/automation-run.mjs",
    "build": "tsc -b && vite build",
    "check:footprint-integrity": "node scripts/footprint-integrity-preflight.mjs",
    "check:knowledge-sources": "node scripts/check-knowledge-sources.mjs",
    "check:net-connectivity": "node scripts/net-connectivity-preflight.mjs",
    "check:schematic-connectivity": "node scripts/schematic-connectivity-preflight.mjs",
    "ci": "npm run typecheck && vitest run && npm run test:runtime && npm run build",
    "desktop:app": "npm run desktop:check && tauri build --bundles app",
    "desktop:build": "npm run desktop:check && tauri build",
    "desktop:check": "node scripts/check-desktop-toolchain.mjs",
    "desktop:dev": "npm run desktop:check && tauri dev",
    "desktop:release": "npm run desktop:release-check && tauri build --bundles app,dmg",
    "desktop:release-check": "node scripts/check-macos-release.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:runtime": "node runtime/server.mjs",
    "drill:backup": "node scripts/backup-restore-drill.mjs",
    "drill:faults": "node scripts/fault-drill.mjs",
    "drill:longrun": "node scripts/long-run-memory.mjs",
    "preflight:pcb": "node scripts/circuitpilot-preflight.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "report:live-chain": "node scripts/live-chain-report.mjs",
    "seed:knowledge:pcb": "node scripts/seed-knowledge-pcb.mjs",
    "seed:knowledge:pcb:api": "node scripts/seed-knowledge-pcb.mjs --api http://127.0.0.1:4178",
    "sidecar:stage": "node scripts/stage-runtime-sidecar.mjs",
    "test": "npm run typecheck && vitest run && npm run test:runtime",
    "test:coverage": "vitest run --coverage",
    "test:coverage:runtime": "node scripts/coverage-gate.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "node scripts/e2e-live.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:package": "node scripts/package-smoke.mjs",
    "test:runtime": "node --test --test-timeout=120000 \"runtime/**/*.test.mjs\"",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify:agent-live": "node scripts/agent-live-acceptance.mjs",
    "verify:agent-mcp-live": "node scripts/agent-mcp-live-acceptance.mjs",
    "verify:rag": "node scripts/verify-rag.mjs",
    "audit:archive": "node scripts/agent-audit-archive.mjs",
    "audit:anchor": "node scripts/agent-audit-archive.mjs anchor",
    "audit:verify-anchor": "node scripts/agent-audit-archive.mjs verify-anchor",
    "bridge:agent": "node scripts/easyeda-agent-bridge.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs --sync",
    "release:manifest": "node scripts/release-manifest.mjs --build",
    "knowledge:pack:verify": "node scripts/knowledge-pack.mjs verify"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^26.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
