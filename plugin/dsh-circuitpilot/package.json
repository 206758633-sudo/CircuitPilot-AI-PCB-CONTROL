{
  "name": "dsh-circuitpilot",
  "version": "0.1.0",
  "description": "DSH native plugin for CircuitPilot: read state, plan, chat-approve, execute and inspect evidence over the local CircuitPilot Runtime.",
  "type": "module",
  "license": "MIT",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./lib/*": "./lib/*",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "circuitpilot",
    "pcb",
    "eda"
  ]
}
